{
  "uid": "needle-drop",
  "title": "Needle Drop \u00b7 App monitoring",
  "tags": [
    "needle-drop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "What these numbers mean",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "needle-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Players = multiplayer seats + visible solo sessions, not unique people.** Activity expires after 20s (multiplayer) / 45s (solo). Solo refreshes reuse a session until 30 minutes idle or a server restart; one person using both modes can count twice. Totals persist; solo history starts with this update. **Traffic = app HTTP body bytes**, excluding Deezer audio and network overhead. Metrics: up to 15 days / 1 GB. Logs: 7 days. Alerts have no external notifications."
      }
    },
    {
      "id": 2,
      "title": "App up",
      "type": "stat",
      "description": "1 = the app metrics listener is reachable; 0 = unreachable.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "needle-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"needle-drop\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "needle-prometheus"
          },
          "legendFormat": "",
          "instant": true
        }
      ]
    },
