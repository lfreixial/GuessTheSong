{
  "uid": "needle-drop",
  "title": "Needle Drop · App monitoring",
  "tags": [
    "needle-drop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "What these numbers mean",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "needle-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Players = multiplayer lobby seats.** Connected means seen in the last 20 seconds. Totals include hosts and repeat joins, exclude solo play, and persist in the app data volume. **Traffic = HTTP body bytes handled by the app**, excluding protocol overhead, upstream Deezer API traffic and music streamed directly to browsers. Rate/period panels use sampled counters; totals begin when monitoring is installed. Metrics: up to 15 days / 1 GB. Logs: 7 days. **Alert rules below do not send external notifications.**"
      }
    },
    {
      "id": 2,
      "title": "App up",
      "type": "stat",
      "description": "1 = the app metrics listener is reachable; 0 = unreachable.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "needle-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"needle-drop\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "needle-prometheus"
          },
          "legendFormat": "",
          "instant": true
        }
      ]
    },
